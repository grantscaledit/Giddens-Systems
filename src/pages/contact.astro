---
import Base from '../layouts/Base.astro';

const title = 'Book a systems audit — Giddens Systems';
const description =
	"Thirty minutes, no charge. We'll map where your leads are dying and send you a " +
	'calendar link within one business day.';
---

<Base title={title} description={description}>
	<section class="contact">
		<div class="content">
			<h1 class="contact-heading">Book a systems audit</h1>
			<p class="contact-sub">
				Thirty minutes, no charge. We'll map where your leads are dying and send you a
				calendar link within one business day.
			</p>

			<div class="contact-consent">
				<h2 class="contact-consent-heading">Before you submit</h2>
				<p>
					Giddens Systems will only text you if you check one of the consent boxes below.
					Checking them is optional — the form submits either way, and consent to receive
					text messages is never a condition of purchase.
				</p>
				<p class="msg-type">
					<strong>Transactional messages</strong> — updates about your inquiry, appointment
					confirmations and reminders, and service updates.
				</p>
				<p class="msg-type">
					<strong>Promotional messages</strong> — occasional offers and news about our
					services, only if you check the second box.
				</p>
				<p>
					Message frequency varies. Message and data rates may apply. Reply STOP at any
					time to opt out, or HELP for help. You must be 18 or older to consent. Carriers
					are not liable for delayed or undelivered messages.
				</p>
				<p>
					See our <a href="/privacy">Privacy Policy</a> and <a href="/terms">Terms of Service</a>.
				</p>
			</div>

			<div class="contact-embed">
				<iframe
					src="https://api.leadconnectorhq.com/widget/form/YSt4r4Vs4Rsyg2no1WiX"
					style="width:100%;min-height:1100px;border:0;display:block;border-radius:0px"
					id="inline-YSt4r4Vs4Rsyg2no1WiX"
					data-layout="{'id':'INLINE'}"
					data-trigger-type="alwaysShow"
					data-trigger-value=""
					data-activation-type="alwaysActivated"
					data-activation-value=""
					data-deactivation-type="neverDeactivate"
					data-deactivation-value=""
					data-form-name="3.0 Contact Form"
					data-height="1369"
					data-layout-iframe-id="inline-YSt4r4Vs4Rsyg2no1WiX"
					data-form-id="YSt4r4Vs4Rsyg2no1WiX"
					title="3.0 Contact Form"></iframe>
			</div>

			<p class="contact-legal">
				By submitting this form you agree to our <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>.
				Consent to receive text messages is not a condition of purchase.
			</p>
		</div>
	</section>

	<script src="https://link.msgsndr.com/js/form_embed.js" is:inline></script>
</Base>

<style>
	.contact {
		padding-block: var(--space-3xl);
	}

	.contact-heading {
		grid-column: 1 / 8;
		font-size: var(--size-display);
		margin-block-end: var(--space-md);
	}

	.contact-sub {
		grid-column: 1 / 8;
		color: var(--text-muted);
		margin-block-end: var(--space-xl);
	}

	/* Disclosure, not pitch. The hairline marks it as a separate zone the way a
	   rule does on a drawing — whitespace alone left it reading as one gray column
	   continuous with the sub-copy above. */
	.contact-consent {
		grid-column: 1 / 9;
		max-width: var(--measure);
		color: var(--text-muted);
		font-size: var(--size-small);
		border-block-start: var(--rule-weight) solid var(--rule);
		padding-block-start: var(--space-lg);
		margin-block-end: var(--space-lg);
	}

	.contact-consent-heading {
		font-size: var(--size-h3);
		margin-block-end: var(--space-sm);
	}

	.contact-consent p + p {
		margin-block-start: var(--space-md);
	}

	/* The two categories are a pair. Tighter to each other than to the prose
	   around them, and the label lifts out of the muted body to read as a label. */
	.contact-consent .msg-type + .msg-type {
		margin-block-start: var(--space-2xs);
	}

	.contact-consent strong {
		color: var(--text-body);
		font-weight: var(--weight-medium);
	}

	.contact-consent a {
		color: var(--text-muted);
	}

	.contact-embed {
		grid-column: 1 / 9;
		margin-block-end: var(--space-lg);
	}

	.contact-legal {
		grid-column: 1 / 9;
		color: var(--text-muted);
		font-size: var(--size-small);
	}

	.contact-legal a {
		color: var(--text-muted);
	}

	@media (max-width: 700px) {
		.contact-heading,
		.contact-sub,
		.contact-consent,
		.contact-embed,
		.contact-legal {
			grid-column: 1 / 13;
		}
	}
</style>
