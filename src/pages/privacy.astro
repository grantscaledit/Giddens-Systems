---
import Base from '../layouts/Base.astro';

const title = 'Privacy Policy — Giddens Systems';
const description = 'How Giddens Systems collects, uses, and shares information from giddens.systems visitors and clients.';
---

<Base title={title} description={description}>
	<section class="legal">
		<div class="content">
			<article class="prose">
				<h1>Privacy Policy</h1>
				<p><strong>Effective August 7, 2026</strong></p>

				<p>
					Giddens Systems LLC ("Giddens Systems," "we," "us") operates giddens.systems.
					This policy explains what information we collect, how we use it, and the
					choices you have.
				</p>

				<h2>Information we collect</h2>
				<p>
					<strong>Information you give us.</strong> When you submit a form, book a call,
					or contact us, we collect your name, business name, email address, phone
					number, and anything you tell us about your business.
				</p>
				<p>
					<strong>Information collected automatically.</strong> When you visit our site
					we may collect your IP address, browser type, device type, pages viewed, and
					referring website. We use this to understand how the site is used and to
					improve it.
				</p>

				<h2>How we use your information</h2>
				<ul>
					<li>To respond to your inquiry and provide the services you request</li>
					<li>To schedule and confirm appointments</li>
					<li>To send service-related messages about work we are performing for you</li>
					<li>To send marketing communications, where you have consented</li>
					<li>To improve our website and services</li>
					<li>To comply with legal obligations</li>
				</ul>

				<h2>SMS and text messaging</h2>
				<p>
					If you provide your mobile number and check the consent box on our contact
					form, you agree to receive text messages from Giddens Systems relating to your
					inquiry, appointments, and services.
				</p>
				<ul>
					<li>Message frequency varies</li>
					<li>Message and data rates may apply</li>
					<li>Reply <strong>STOP</strong> at any time to opt out</li>
					<li>
						Reply <strong>HELP</strong> for assistance, or contact us
						at <a href="mailto:grant@giddens.systems">grant@giddens.systems</a>
					</li>
					<li>Carriers are not liable for delayed or undelivered messages</li>
					<li>Consent to receive text messages is not a condition of any purchase</li>
				</ul>
				<p>
					<strong>No mobile information will be sold, rented, or shared with third
					parties or affiliates for marketing or promotional purposes.</strong> Text
					messaging originator opt-in data and consent are not shared with any third
					party except subprocessors acting on our behalf to deliver the messages you
					requested.
				</p>

				<h2>How we share information</h2>
				<p>We do not sell your personal information. We share it only with:</p>
				<ul>
					<li>
						<strong>Service providers</strong> who help us operate — hosting, CRM,
						email, and messaging platforms — who may only use it to provide services
						to us
					</li>
					<li><strong>Legal authorities</strong>, where required by law or to protect our rights</li>
				</ul>

				<h2>Data security</h2>
				<p>
					We take reasonable and appropriate measures to protect your personal
					information from unauthorized access, disclosure, alteration, and
					destruction. These include encryption of data in transit using
					industry-standard TLS, access controls limiting who within our organization
					can view your information, and vetting the third-party service providers who
					process data on our behalf.
				</p>
				<p>
					No method of transmission or storage is completely secure, so we cannot
					guarantee absolute security. If we become aware of a data breach affecting
					your personal information, we will notify you and any relevant authorities as
					required by applicable law.
				</p>
				<p>
					You can request deletion of your information at any time by
					emailing <a href="mailto:grant@giddens.systems">grant@giddens.systems</a>.
				</p>

				<h2>Data retention</h2>
				<p>
					We keep your information for as long as needed to provide services and meet
					legal obligations. You may request deletion at any time by
					emailing <a href="mailto:grant@giddens.systems">grant@giddens.systems</a>.
				</p>

				<h2>Your choices</h2>
				<ul>
					<li><strong>Email:</strong> unsubscribe using the link in any marketing email</li>
					<li><strong>Text messages:</strong> reply STOP to any message</li>
					<li>
						<strong>Access, correction, or deletion:</strong>
						email <a href="mailto:grant@giddens.systems">grant@giddens.systems</a>
					</li>
				</ul>

				<h2>Cookies</h2>
				<p>
					We use cookies and similar technologies to operate the site and understand
					usage. Most browsers let you refuse cookies; some site features may not work
					if you do.
				</p>

				<h2>Children</h2>
				<p>
					Our services are for businesses. We do not knowingly collect information from
					anyone under 18.
				</p>

				<h2>Changes</h2>
				<p>
					We may update this policy. Material changes will be posted here with a
					revised effective date.
				</p>

				<h2>Contact</h2>
				<address>
					Giddens Systems LLC<br />
					McKinney, Texas<br />
					<a href="mailto:grant@giddens.systems">grant@giddens.systems</a>
				</address>
			</article>
		</div>
	</section>
</Base>

<style>
	.legal {
		padding-block: var(--space-3xl);
	}

	.prose {
		grid-column: 1 / 8;
		max-width: var(--measure);
	}

	.prose h1 {
		margin-block-end: var(--space-lg);
	}

	.prose h2 {
		font-size: var(--size-h3);
		margin-block: var(--space-xl) var(--space-sm);
	}

	.prose p {
		margin-block-end: var(--space-md);
		max-width: none;
	}

	.prose ul {
		margin: 0 0 var(--space-md);
		padding-inline-start: var(--space-lg);
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.prose a {
		color: var(--text-muted);
	}

	.prose address {
		font-style: normal;
		color: var(--text-body);
	}

	@media (max-width: 700px) {
		.prose {
			grid-column: 1 / 13;
		}
	}
</style>
