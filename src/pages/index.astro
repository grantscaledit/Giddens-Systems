---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Offer from '../components/Offer.astro';
import TheSystem from '../components/TheSystem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import FinalCta from '../components/FinalCta.astro';

const title = 'Giddens Systems | Websites, CRM, and AI call intake — McKinney TX';
const description =
	'One system that catches every lead: an SEO-built website, a CRM that holds the ' +
	'whole pipeline, and AI intake that answers the calls you miss. For service ' +
	'businesses across North Texas.';
---

<Base title={title} description={description}>
	<Hero />
	<Offer />
	{/* 03 · Proof band — blocked on real numbers from Marie and AG Home Services */}
	<TheSystem />
	{/* 05 / 06 · Case studies — blocked on testimonial collection */}
	<HowItWorks />
	<Pricing />
	{/* 09 · Material band — blocked on footage that was never shot */}
	<FinalCta />
</Base>
