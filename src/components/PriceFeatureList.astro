---
// Feature list inside a tier. Instrument Sans (inherited body face — no
// override needed, "feature lists in Instrument Sans" just means don't
// touch it). An em dash marker, not an icon or checkmark — icons standing in
// where proof should be is banned, and a plain dash keeps the register flat
// and mechanical rather than decorative.
interface Props {
	items: string[];
}

const { items } = Astro.props;
---

<ul class="price-feature-list" role="list">
	{items.map((item) => <li>{item}</li>)}
</ul>

<style>
	/* Two columns, not one. The list used to sit in a 280px tier card where a
	   single column was the only option. It now sits in a band at columns 5-12
	   — roughly 700px — and the longest item measures about 290px, so a single
	   column would leave 400px of empty rail on every line. That emptiness is
	   the exact failure the band layout exists to fix. Multi-column rather than
	   flex because the items are independent one-liners and column balancing is
	   what makes eleven of them read as a block instead of a queue. */
	.price-feature-list {
		list-style: none;
		margin: 0;
		padding: 0;
		columns: 2;
		column-gap: var(--grid-gap);
		font-size: var(--size-small);
	}

	.price-feature-list li {
		position: relative;
		padding-inline-start: var(--space-md);
		break-inside: avoid;
		margin-block-end: var(--space-xs);
	}

	@media (max-width: 700px) {
		.price-feature-list {
			columns: 1;
		}
	}

	.price-feature-list li::before {
		content: '—';
		position: absolute;
		left: 0;
		/* --text-body, not --text-muted: the marker sits on --bg-raised inside
		   the Growth tier, where steel-400 only clears 3.76:1 — below the 4.5:1
		   floor. chalk-200 clears both that surface (8.9:1) and the page
		   background the other two tiers sit on (12.3:1). */
		color: var(--text-body);
	}
</style>
